+// Some Chrome builds/locales append a keyboard-shortcut hint to the New Tab
+// button's accessible name (e.g. "New Tab (⌘T)"), which field_equals's exact
+// match rejects outright, so this flow refuses with a spurious zero-match
+// error on those windows. Match on a "new tab" prefix instead of full
+// equality; still requires the exact AXButton role + AXPress action, and
+// still fails closed via unique_actionable's own ambiguity refusal if more
+// than one control's name starts with "New Tab".
+fn field_starts_with(node: &AXNode, expected_prefix: &str) -> bool {
+    [
+        node.title.as_deref(),
+        node.value.as_deref(),
+        node.description.as_deref(),
+        node.help.as_deref(),
+    ]
+    .into_iter()
+    .flatten()
+    .any(|value| {
+        value
+            .trim()
+            .to_ascii_lowercase()
+            .starts_with(&expected_prefix.to_ascii_lowercase())
+    })
+}
+
+// Chrome's own AX tree sometimes exposes the same physical control as
+// several distinct AXUIElementRefs (observed: 3 separate "New Tab" AXButton
+// nodes, identical role/label/actions, at the exact same frame) — a
+// Chromium accessibility-tree quirk, not genuine ambiguity. Collapsing
+// exact-frame duplicates before counting keeps real ambiguity (distinct
+// on-screen controls sharing a name prefix) fail-closed while not refusing
+// on this false-multiplicity case.
+fn dedupe_by_frame<T>(items: Vec<T>, frame_of: impl Fn(&T) -> Option<[f64; 4]>) -> Vec<T> {
+    let mut seen: Vec<[u64; 4]> = Vec::new();
+    let mut out = Vec::new();
+    for item in items {
+        let Some(frame) = frame_of(&item) else {
+            out.push(item);
+            continue;
+        };
+        let key = [
+            frame[0].to_bits(),
+            frame[1].to_bits(),
+            frame[2].to_bits(),
+            frame[3].to_bits(),
+        ];
+        if !seen.contains(&key) {
+            seen.push(key);
+            out.push(item);
+        }
+    }
+    out
+}
+
+fn unique_actionable_prefix(
+    nodes: &[AXNode],
+    role: &str,
+    label_prefix: &str,
+    action: &str,
+) -> Result<Option<usize>, BrowserRefusal> {
+    let candidates = nodes
+        .iter()
+        .filter(|node| {
+            node.role == role && field_starts_with(node, label_prefix) && has_action(node, action)
+        })
+        .collect::<Vec<_>>();
+    let matches = dedupe_by_frame(candidates, |node: &&AXNode| node.frame)
+        .into_iter()
+        .map(|node| node.element_ptr)
+        .collect::<Vec<_>>();
+    match matches.as_slice() {
+        [] => Ok(None),
+        [element] => Ok(Some(*element)),
+        _ => Err(refusal(
+            BrowserRefusalCode::BrowserWrongTargetRefused,
+            format!("multiple {role} controls matched a {label_prefix:?} prefix"),
+        )),
+    }
+}
